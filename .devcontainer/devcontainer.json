// Dev container for Vialix (Android). Format: https://aka.ms/devcontainer.json
{
	"name": "Vialix (Android)",
	"image": "mcr.microsoft.com/devcontainers/java:3-25-trixie",

	"features": {
	// Pin to the Java 25 LTS that Gradle 9.2 supports. Without a version the feature
	// installs the newest JDK (26), which Gradle 9.2.1 rejects.
	"ghcr.io/devcontainers/features/java:1": { "version": "25" },
	"ghcr.io/devcontainers/features/node:1": {},
	// GitHub CLI, so PRs can be opened from the terminal (and by coding agents).
	"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// AGP reads ANDROID_HOME when local.properties (git-ignored) is absent.
	"containerEnv": {
		"ANDROID_HOME": "/opt/android-sdk",
		"ANDROID_SDK_ROOT": "/opt/android-sdk"
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/bin:${containerEnv:PATH}:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools"
	},

	// Persist Gradle downloads, Antigravity settings and the gh login across rebuilds.
	// The vialix-gradle-cache volume name predates the OpenNav -> Vialix rename; renaming it would
	// start with an empty Gradle cache, so it is kept as is.
	"mounts": [
		"source=vialix-gradle-cache,target=/home/vscode/.gradle,type=volume",
		"source=vialix-gemini-config,target=/home/vscode/.gemini,type=volume",
		"source=vialix-gh-config,target=/home/vscode/.config/gh,type=volume"
	],

	// Installs the Android command-line tools, platform 37, build-tools 36.0.0 and platform-tools.
	"postCreateCommand": "bash .devcontainer/install-android-sdk.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"fwcd.kotlin",
				"vscjava.vscode-gradle"
			],
			"settings": {
				"java.configuration.runtimes": [
					{
						"name": "JavaSE-25",
						"path": "/usr/lib/jvm/msopenjdk-current",
						"default": true
					}
				],
				"java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current"
			}
		}
	}
}
