<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a route drawn as a "V" (Vialix, from Latin via = road). It starts at a
  location ring on the left, turns sharply at the bottom and ends in an arrowhead on the right,
  the turn-by-turn manoeuvre in one glyph. Everything sits inside the 66 dp adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Route: left arm from the start ring down to the turn, right arm up to the arrow base. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M36,40 L54,68 L66.6,48.4" />
    <!-- Arrowhead pointing along the right arm. -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M74.2,36.6 L74.2,53.3 L59,43.5 Z" />
    <!-- Start: location ring (white) with a hole in the background blue. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,40 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
    <path
        android:fillColor="#1F5FBF"
        android:pathData="M36,40 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0 Z" />
</vector>
