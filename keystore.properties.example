# Copy to keystore.properties (git-ignored) to sign release builds locally. CI reads the same
# four values from the VIALIX_STORE_FILE / VIALIX_STORE_PASSWORD / VIALIX_KEY_ALIAS /
# VIALIX_KEY_PASSWORD environment (see .github/workflows/release.yml). Without either,
# assembleRelease produces an unsigned APK.
storeFile=/absolute/path/to/vialix-release.jks
storePassword=
keyAlias=vialix
keyPassword=
